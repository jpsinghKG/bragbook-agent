# Git local collector
GIT_LOCAL_IDENTITIES="id1,id2,id3"
GIT_LOCAL_ROOTS="/path1,/path2,/path3" # absolute paths, avoid commas in paths

# GitHub collector
GITHUB_IDENTITIES="id1,id2,id3"
GITHUB_API_TOKEN="gh_token"

# Linear Collector
LINEAR_API_TOKEN="lin_token"

# LLM
LLM_PROVIDER="openai|anthropic|google|ollama"
LLM_MODEL="model_name"

# One of, matching LLM_PROVIDER above:
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_API_KEY="..."
OLLAMA_BASE_URL="http://localhost:11434/v1" # ollama only, no API key needed